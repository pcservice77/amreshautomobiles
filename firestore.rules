
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRole() {
      return getUserData().role;
    }

    function isAdmin() {
      return isAuthenticated() && getRole() == 'admin';
    }
    
    function isBranchAdmin(branchId) {
      let userData = getUserData();
      return isAuthenticated() && 
        userData.role == 'branch_admin' && 
        userData.assignedBranchId == branchId;
    }

    // User Profile Rules
    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Scooter Inventory Rules
    match /scooters/{scooterId} {
      allow read: if true;
      allow write: if isAdmin() || (isAuthenticated() && getRole() == 'branch_admin');
    }

    // Sales Record Rules
    match /sales/{saleId} {
      allow read: if true; // Allowed for customer lookup via specific queries
      allow write: if isAdmin() || (isAuthenticated() && getRole() == 'branch_admin');
    }

    // Branch Rules
    match /branches/{branchId} {
      allow read: if true;
      allow update: if isAdmin() || isBranchAdmin(branchId);
      allow create, delete: if isAdmin();
    }

    // Test Ride Booking Rules
    match /bookings/{bookingId} {
      allow create: if true;
      allow read: if isAdmin() || (isAuthenticated() && isBranchAdmin(resource.data.branchId));
      allow update: if isAdmin() || (isAuthenticated() && isBranchAdmin(resource.data.branchId));
      allow delete: if isAdmin() || (isAuthenticated() && isBranchAdmin(resource.data.branchId));
    }

    // Service Booking Rules
    match /service-bookings/{bookingId} {
      allow create: if true;
      allow read: if isAdmin() || (isAuthenticated() && isBranchAdmin(resource.data.branchId));
      allow update: if isAdmin() || (isAuthenticated() && isBranchAdmin(resource.data.branchId));
      allow delete: if isAdmin() || (isAuthenticated() && isBranchAdmin(resource.data.branchId));
    }

    // Showroom Settings Rules
    match /settings/showroom {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Festive Offers Rules
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin() || (isAuthenticated() && getRole() == 'branch_admin');
    }
  }
}
