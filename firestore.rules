rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Get user data once per request
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }
    
    function isBranchAdmin(branchId) {
      let userData = getUserData();
      return isAuthenticated() && 
        userData.role == 'branch_admin' && 
        userData.assignedBranchId == branchId;
    }

    // User Profile Rules
    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Scooter Inventory Rules
    match /scooters/{scooterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sales Record Rules
    match /sales/{saleId} {
      // Allow branch admins to list sales if they filter by their own branchId
      // Or allow admins to read everything
      allow read: if isAdmin() || (isAuthenticated() && (
        (resource == null || resource.data.branchId == getUserData().assignedBranchId) ||
        hasRole('branch_admin')
      ));
      allow create: if isAdmin() || hasRole('branch_admin');
      allow update: if isAdmin() || (isAuthenticated() && isBranchAdmin(resource.data.branchId));
      allow delete: if isAdmin();
    }

    // Branch Rules
    match /branches/{branchId} {
      allow read: if true;
      allow update: if isAdmin() || isBranchAdmin(branchId);
      allow create, delete: if isAdmin();
    }

    // Test Ride Booking Rules
    match /bookings/{bookingId} {
      allow create: if true;
      allow read: if isAdmin() || (isAuthenticated() && (
        hasRole('branch_admin') // Allow branch admins to see bookings to filter them
      ));
      allow update: if isAdmin() || (isAuthenticated() && isBranchAdmin(resource.data.branchId));
      allow delete: if isAdmin();
    }

    // Showroom Settings Rules
    match /settings/showroom {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}