
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user information stored in Firestore.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] }
      },
      "required": ["uid", "email", "role"]
    },
    "Scooter": {
      "title": "Scooter",
      "description": "Details of an electric scooter model.",
      "type": "object",
      "properties": {
        "model": { "type": "string" },
        "variant": { "type": "string" },
        "range": { "type": "string" },
        "price": { "type": "string" },
        "topSpeed": { "type": "string" },
        "batteryType": { "type": "string" },
        "batteryCapacity": { "type": "string" },
        "imageUrl": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["model", "range", "price", "imageUrl", "description"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Record of a scooter sale transaction with full vehicle and customer specs.",
      "type": "object",
      "properties": {
        "invoiceNo": { "type": "string" },
        "customerName": { "type": "string" },
        "customerFatherName": { "type": "string" },
        "mobile": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "pin": { "type": "string" },
        "idType": { "type": "string" },
        "idNumber": { "type": "string" },
        "model": { "type": "string" },
        "variant": { "type": "string" },
        "color": { "type": "string" },
        "batteryType": { "type": "string" },
        "batteryCapacity": { "type": "string" },
        "claimedRange": { "type": "string" },
        "chassisNumber": { "type": "string" },
        "motorNumber": { "type": "string" },
        "controllerNumber": { "type": "string" },
        "vehicleSerialNumber": { "type": "string" },
        "registrationNumber": { "type": "string" },
        "price": { "type": "number" },
        "hsn": { "type": "string" },
        "gstin": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "financeCompany": { "type": "string" },
        "loanAmount": { "type": "number" },
        "downPayment": { "type": "number" },
        "utrNumber": { "type": "string" },
        "soldAt": { "type": "string", "format": "date-time" }
      }
    },
    "ShowroomSettings": {
      "title": "Showroom Settings",
      "description": "Global settings for the showroom details.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "contact": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "gstin": { "type": "string" },
        "bankName": { "type": "string" },
        "accountName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "ifsc": { "type": "string" },
        "branch": { "type": "string" },
        "useLetterhead": { "type": "boolean" },
        "letterheadUrl": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profile data including roles."
    },
    "/scooters/{scooterId}": {
      "schema": "Scooter",
      "description": "Inventory of electric scooters."
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Transaction history."
    },
    "/settings/showroom": {
      "schema": "ShowroomSettings",
      "description": "Showroom contact and name details."
    }
  }
}
