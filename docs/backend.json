{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user information stored in Firestore.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "branch_admin", "user"] },
        "assignedBranchId": { "type": "string", "description": "ID of the branch this user manages if they are a branch_admin." }
      },
      "required": ["uid", "email", "role"]
    },
    "Scooter": {
      "title": "Scooter",
      "description": "Details of an electric scooter model.",
      "type": "object",
      "properties": {
        "model": { "type": "string" },
        "tagline": { "type": "string" },
        "variant": { "type": "string" },
        "range": { "type": "string" },
        "price": { "type": "string" },
        "topSpeed": { "type": "string" },
        "batteryType": { "type": "string" },
        "batteryCapacity": { "type": "string" },
        "voltage": { "type": "string" },
        "category": { "type": "string" },
        "batterySystem": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } },
        "availableColors": { "type": "string" },
        "brochureUrl": { "type": "string" },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "range": { "type": "string" },
              "price": { "type": "string" }
            }
          }
        }
      },
      "required": ["model", "range", "price", "images", "description"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Record of a scooter sale transaction.",
      "type": "object",
      "properties": {
        "invoiceNo": { "type": "string" },
        "customerName": { "type": "string" },
        "mobile": { "type": "string" },
        "model": { "type": "string" },
        "price": { "type": "number" },
        "branchId": { "type": "string" },
        "soldAt": { "type": "string", "format": "date-time" },
        "chassisNumber": { "type": "string" },
        "batterySerialNumber": { "type": "string", "description": "Optional serial number of the battery unit." },
        "email": { "type": "string" }
      }
    },
    "Branch": {
      "title": "Branch",
      "description": "A showroom branch location.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "pincode": { "type": "string" },
        "contact": { "type": "string" },
        "email": { "type": "string" },
        "imageUrl": { "type": "string" },
        "gstin": { "type": "string" },
        "tagline": { "type": "string" },
        "googleMapUrl": { "type": "string", "description": "Link to the Google Maps location for this branch." }
      },
      "required": ["name", "city", "pincode"]
    },
    "TestRideBooking": {
      "title": "Test Ride Booking",
      "description": "A request for a test ride from a customer.",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "mobile": { "type": "string" },
        "address": { "type": "string" },
        "scooterModel": { "type": "string" },
        "branchId": { "type": "string" },
        "preferredDate": { "type": "string" },
        "preferredTime": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "email", "mobile", "scooterModel", "branchId", "preferredDate"]
    },
    "ServiceBooking": {
      "title": "Service Booking",
      "description": "A request for vehicle maintenance.",
      "type": "object",
      "properties": {
        "saleId": { "type": "string" },
        "customerName": { "type": "string" },
        "mobile": { "type": "string" },
        "email": { "type": "string" },
        "chassisNumber": { "type": "string" },
        "model": { "type": "string" },
        "branchId": { "type": "string" },
        "currentKm": { "type": "number" },
        "serviceType": { "type": "string", "enum": ["Routine", "Repair", "Warranty", "Battery Check"] },
        "preferredDate": { "type": "string" },
        "preferredTime": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["saleId", "branchId", "currentKm", "preferredDate"]
    },
    "ShowroomSettings": {
      "title": "Showroom Settings",
      "description": "Global settings for the showroom details.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "contact": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "gstin": { "type": "string" },
        "useLetterhead": { "type": "boolean" },
        "letterheadUrl": { "type": "string" },
        "logoUrl": { "type": "string" }
      }
    },
    "FestiveOffer": {
      "title": "Festive Offer",
      "description": "A dynamic promotional offer shown on the site.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "discount": { "type": "string" },
        "imageUrl": { "type": "string", "description": "Base64 image for the offer banner/pop-up." },
        "branchId": { "type": "string", "description": "Specific branch this offer applies to, or 'global'." },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "discount", "startDate", "endDate", "isActive"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profile data including roles and branch assignments."
    },
    "/scooters/{scooterId}": {
      "schema": "Scooter",
      "description": "Inventory of electric scooters."
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Transaction history."
    },
    "/branches/{branchId}": {
      "schema": "Branch",
      "description": "List of showroom branch locations."
    },
    "/bookings/{bookingId}": {
      "schema": "TestRideBooking",
      "description": "Customer test ride bookings."
    },
    "/service-bookings/{bookingId}": {
      "schema": "ServiceBooking",
      "description": "Customer vehicle service requests."
    },
    "/settings/showroom": {
      "schema": "ShowroomSettings",
      "description": "Showroom contact and name details."
    },
    "/offers/{offerId}": {
      "schema": "FestiveOffer",
      "description": "Promotional banners and flash sales."
    }
  }
}